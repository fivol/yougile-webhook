# YouGile webhook receiver — global configuration.
# Per-rule settings live in rules.toml. Copy this to .env and edit.

# === YouGile API ===
YOUGILE_API_KEY=your_yougile_api_key
YOUGILE_API_BASE=https://yougile.com/api-v2
YOUGILE_WEBHOOK_URL=https://your.public.domain/yougile/webhook
# Event spec used by register_webhook.py. Regex supported. Make it broad so
# rules.toml can route different event types.
YOUGILE_WEBHOOK_EVENT=(chat_message|task)-.*
# Optional server-side chat-text filter (regex).
YOUGILE_WEBHOOK_CHAT_FILTER=
# How often (seconds) the receiver itself sweeps its YouGile subscription and
# revives it if YouGile disabled it after failed deliveries. 900 = 15 min.
WEBHOOK_ENSURE_INTERVAL_SECONDS=900
# After a FAILED ensure cycle (couldn't reach YouGile / couldn't revive the
# subscription) retry this soon instead of waiting the full interval, so we
# recover from an outage in minutes, not up to 15 min.
WEBHOOK_ENSURE_RETRY_SECONDS=60

# --- YouGile API retry policy ---
# A flapping VPN / brief YouGile outage / TLS handshake timeout must never lose
# a 👍, an ack, or a chat-history read. Each attempt is bounded by the timeout
# below; transient failures (network error, timeout, HTTP 429/5xx) retry with
# capped exponential backoff. A 4xx is permanent and never retried.
YOUGILE_API_TIMEOUT=30
# Retries for data-plane calls (reaction, ack, history, message post).
# 0 = retry forever.
YOUGILE_API_MAX_RETRIES=0
# Bounded budget for boot/control-plane calls (directory load, webhook
# (de)registration) so a dead API at startup can't hang the import.
YOUGILE_API_BOOT_RETRIES=2
# Budget for the background subscription watcher's ensure() — runs off the
# request path, so it can afford more retries than the boot budget before it
# backs off to WEBHOOK_ENSURE_RETRY_SECONDS and tries again.
YOUGILE_API_WATCHER_RETRIES=5
# Backoff between retries: starts at BASE, doubles, capped at MAX (seconds).
YOUGILE_API_RETRY_BASE_DELAY=1
YOUGILE_API_RETRY_MAX_DELAY=30

# --- Network resilience ---
# The #1 cause of "SSL handshake timed out" on an otherwise-healthy host is a
# broken/half-open IPv6 route: getaddrinfo hands out an AAAA record, urllib
# (no Happy-Eyeballs) tries it, and TLS stalls on the dead route until timeout —
# while curl connects instantly over IPv4. Forcing IPv4 for outbound DNS avoids
# that entirely. Set to false only if your host genuinely needs IPv6.
NETWORK_FORCE_IPV4=true
# Event-loop watchdog: if the asyncio loop wedges (stops heart-beating) for
# longer than this, the process force-exits so launchd (KeepAlive) restarts a
# fresh one. Network outages do NOT trigger it — a restart wouldn't help those.
# Set to 0 to disable. Check cadence is separate.
LOOP_WATCHDOG_TIMEOUT_SECONDS=180
LOOP_WATCHDOG_CHECK_SECONDS=15

# === HTTP server ===
HOST=127.0.0.1
PORT=9100

# === Claude defaults — can be overridden per rule in rules.toml ===
CLAUDE_BIN=/path/to/claude
CLAUDE_WORKDIR=/path/to/your/project
CLAUDE_EXTRA_ARGS=--dangerously-skip-permissions
# Hard cap on simultaneously-running claude processes (across DISTINCT chats).
# A new @Agent message for a chat that's already running does NOT count here —
# it interrupts that chat's in-flight turn instead (see below). Only genuinely
# new chats hit this cap; when they do, the chat gets CONCURRENCY_BUSY_MESSAGE.
CLAUDE_MAX_CONCURRENT=10
# When CLAUDE_MAX_CONCURRENT is saturated by OTHER chats, post this into the chat
# instead of silently dropping the trigger. Empty = stay silent. *_HTML optional.
CONCURRENCY_BUSY_MESSAGE="I'm at capacity right now — too many tasks are running in parallel. Please mention @Agent again in a couple of minutes and I'll pick this up."
# CONCURRENCY_BUSY_MESSAGE_HTML=
# A new @Agent message in a chat whose turn is still running INTERRUPTS it: we
# SIGTERM the in-flight turn's process group, wait this many 0.1s ticks (so
# claude can flush its session), then SIGKILL, and immediately start a fresh
# turn that --resumes the same session with the new instruction. Default 30 (~3s).
INTERRUPT_SIGKILL_GRACE_TICKS=30

# === Rules ===
RULES_FILE=rules.toml

# === Payload key lookup (used to extract sender / column / chat-id from events) ===
SENDER_KEYS=fromUserId,createdBy,userId,authorId,senderId,from
COLUMN_KEYS=columnId,toColumnId,newColumnId,destinationColumnId
# Keys checked (in order) for the chat/task UUID used to key claude sessions.
# Values that aren't UUID-shaped are skipped (so numeric message ids don't confuse us).
CHAT_ID_KEYS=chatId,id

# === Chat history fetched into the prompt on each spawn ===
# How many recent messages to include the FIRST time a chat triggers claude.
CHAT_HISTORY_FIRST_TIME_LIMIT=20
# How many to include on subsequent triggers (only messages newer than last seen).
CHAT_HISTORY_DELTA_LIMIT=50

# === Attachments (images & files dropped into YouGile chat) ===
# Each `/root/#file:<url>` marker in a message is downloaded into
# state/attachments/<chatId>/ and surfaced to the agent in the rendered chat
# history as `[image: /abs/path]` / `[file: /abs/path]`. The agent reads them
# with its Read tool (images render visually).
ATTACHMENTS_ENABLED=true
# Per-file size cap. Anything larger is skipped (the marker stays unresolved).
ATTACHMENT_MAX_BYTES=26214400
# Per-file download timeout in seconds.
ATTACHMENT_TIMEOUT_SECONDS=60
# Retry a transient download (network error, timeout, 5xx) this many times
# before giving up. A 4xx or an over-size file is permanent and not retried.
ATTACHMENT_MAX_RETRIES=3

# === Trigger reaction ("received" signal) ===
# Emoji reaction dropped on the trigger message the instant it matches a rule —
# fires before the agent spawns and before any ack reply, so the sender sees an
# immediate "got it". YouGile accepts ONLY this fixed set:
#   👍 👎 👏 🙂 😀 😕 🎉 ❤ 🚀 ✔   (👀 is rejected by the API).
# Leave empty to disable reacting.
ACK_REACTION_EMOJI=👍

# === Agent status sticker ===
# A sticker on the task card says what the agent is doing:
#   "working"  -> a turn is running, the answer isn't in yet — wait
#   "answered" -> the agent stopped and left its reply in the chat — go read it
# A turn sets `working` when it spawns and `answered` when it exits (an
# interrupt or a queued follow-up keeps it on `working` — the agent isn't done).
# Written only when the value actually changes, so it doesn't spam task-updated
# events. Set to false to leave task cards alone.
#
# NOT the task's `completed` checkbox: YouGile rejects a `completed` write (both
# directions, HTTP 400) from any account that isn't among the task's assignees,
# so the checkbox can't carry this on a task assigned to a human. Stickers are
# writable on any task.
AGENT_STATUS_STICKER=true
# The sticker is looked up BY NAME and created on first use if missing. Enable it
# on the boards where you want it visible (one-time, in the YouGile UI).
AGENT_STICKER_NAME=Agent
AGENT_STICKER_ICON=pin
# State names must match the sticker's states EXACTLY. YouGile's API can rename a
# sticker but cannot edit its states, so if you change these after the sticker
# exists, add the matching state by hand in the UI.
AGENT_STICKER_WORKING=working
AGENT_STICKER_ANSWERED=answered
# Colours used only when creating the sticker.
AGENT_STICKER_WORKING_COLOR=#8CC2FF
AGENT_STICKER_ANSWERED_COLOR=#79CE69

# === Replying to the agent counts as mentioning it ===
# Replying to (or forwarding) one of the agent's own messages addresses the
# agent just as much as typing the mention — YouGile just leaves the text
# mention-free. Such a message gets AGENT_MENTION injected into its payload, so
# the ordinary `@Agent` rules fire on it unchanged.
REPLY_TO_AGENT_IS_MENTION=true
# The mention token your rules match on, and the one YouGile renders for the
# agent's account.
AGENT_MENTION=@Agent
# Which account the agent posts as — needed to tell a reply to the agent from a
# reply to a colleague. Normally learned automatically from the first "@Agent …"
# message and cached in state/agent.json; set one of these to pin it (and to arm
# the feature before any mention has been seen).
# AGENT_USER_EMAIL=agent@example.com
# AGENT_USER_ID=<user-uuid>
# How much of the replied-to message to quote into the prompt so the agent knows
# which of its own messages the user is answering.
REPLY_QUOTE_MAX_CHARS=2000

# === Session rotation ===
# A chat's claude session grows every turn, and so does the cost of carrying it.
# Whether the next turn re-reads that context cheaply (cache hit, 0.1x input
# price) or re-writes it in full (cache miss, 2x) is almost entirely a function
# of how long the chat has been idle — measured over 88 real turns:
#   <10 min  7% miss    30-60 min  75% miss
#   10-30    24% miss   >60 min   100% miss
# So the cost of the NEXT turn is knowable before spending a token: context size
# comes from the previous turn's usage block, idle time from the clock. Once it
# crosses the threshold the session is retired and a fresh one starts, carrying
# a handoff (task chat + workspace + PR diffs) instead of the raw transcript.
# Net effect: a live conversation keeps its context (cheap while warm); one
# picked up after a long pause resets (its context would be re-billed at 2x).
#
#   auto   — rotate and post a notice explaining what it cost and why
#   manual — never rotate; post an advisory when the threshold trips (start here)
#   off    — feature disabled, behaviour identical to v1.3
SESSION_ROTATE_MODE=manual
# The knob that matters, in dollars: rotate when the next turn would cost more.
# Rough context ceilings this implies: ~1.3M tokens if the chat is hot (<10 min),
# ~540k at 10-30 min, ~200k at 30-60 min, ~150k after an hour.
ROTATE_TURN_COST_USD=1.50
# Rotate regardless of cost past this size — the 1M window is a wall we must not
# hit mid-task (real sessions here reached 950k).
ROTATE_HARD_CTX=600000
# Never rotate a session smaller than this, whatever the arithmetic says.
ROTATE_MIN_CTX=40000

# === Handoff ===
# What the new session gets in place of the retired transcript. Assembled
# mechanically at zero model cost: task card, the FULL YouGile chat, the old
# session's conclusions, and per-repo branch/PR/diff --stat.
# Messages pulled into the handoff file (0 = the whole chat).
HANDOFF_HISTORY_LIMIT=0
# How many of the most recent messages also go inline into the first prompt —
# the rest the agent reads from the file.
HANDOFF_INLINE_MESSAGES=30
# Optional second pass: compress a fat handoff with a cheap model, in a FRESH
# session (never by resuming the expensive one we are escaping). `off` disables.
HANDOFF_DIGEST=auto
HANDOFF_DIGEST_THRESHOLD_KB=64
HANDOFF_DIGEST_MODEL=sonnet
HANDOFF_DIGEST_TIMEOUT=180

# === Pricing ===
# Anthropic API list price. Every figure the webhook reports is an estimate at
# these rates — on a subscription the absolute numbers are notional, but the
# ratio between a cache hit and a miss (and so the rotation decision) holds.
PRICE_IN_PER_MTOK=5.0
PRICE_OUT_PER_MTOK=25.0
# Cache write is 1.25x at the 5-minute TTL and 2x at 1 hour; claude uses 1h.
CACHE_WRITE_MULT=2.0
CACHE_READ_MULT=0.1

# === Chat commands ===
# Answered by the receiver itself: no agent spawn, no tokens, no sticker change.
#   /status /sessions /new /keep /stop /help
# Work with or without the @Agent prefix. Command messages and the replies to
# them are stripped from the history the agent sees.
COMMANDS_ENABLED=true
# Who may run them. Empty = the union of every rule's allowed_sender_emails.
# COMMAND_ALLOWED_EMAILS=you@example.com
# Marks the receiver's own replies so they can be filtered back out.
COMMAND_REPLY_PREFIX=⚙️
# Append the context/cost block to the ack the agent posts ("Продолжаю …").
ACK_STATS=true
