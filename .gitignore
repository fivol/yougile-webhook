.env
.venv/
logs/
state/
__pycache__/
*.pyc

# Committed = the engine (same for every install). Ignored = this instance:
# anything naming your machine, your people or your workspace. Prompts follow
# the same line: `prompts/*.txt` ship as defaults, `prompts/local/<same-name>`
# shadows one without touching it.
rules.toml
prompts/local/

# per-machine settings overriding config.yaml
config.local.yaml

# local Claude Code instructions (per-checkout, not for the public repo)
CLAUDE.local.md

# per-checkout tooling: Claude Code worktrees, IDE settings
.claude/
.idea/
